# OneClick systemd service - the production-grade service launcher.
#
# Survives terminal/SSH session closing and restarts automatically on crash/reboot.
#
# INSTALL:
#   1. Edit the paths below (User, WorkingDirectory, ExecStart) to match
#      your actual install location and username.
#   2. sudo cp oneclick.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now oneclick
#
# USEFUL COMMANDS:
#   sudo systemctl status oneclick       # is it running?
#   sudo journalctl -u oneclick -f       # live logs
#   sudo journalctl -u oneclick -n 100   # last 100 log lines
#   sudo systemctl restart oneclick
#   sudo systemctl stop oneclick

[Unit]
Description=OneClick APK/Phishing/Threat Analyzer (FastAPI & React Web UI)
After=network.target
# Don't restart-loop forever if it's a genuine startup failure (config error, etc.)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kali
WorkingDirectory=/home/kali/OneClick
ExecStartPre=/usr/bin/python3 /home/kali/OneClick/doctor.py
ExecStart=/usr/bin/python3 -m uvicorn api:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

# Basic hardening
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
