{
  "manifest_version": 3,
  "name": "OneClick Phishing Guard",
  "version": "0.1.0",
  "description": "Checks the current page's URL against OneClick's phishing scanner before you enter any information. Flag-only — never blocks or modifies pages automatically.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
