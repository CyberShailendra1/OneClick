# =============================================================================
# OneClick Security Suite — Environment Configuration & API Keys
# =============================================================================
# Copy this file to .env and fill in your actual API keys / tokens:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. VirusTotal API Key
# -----------------------------------------------------------------------------
# Required for:
#   - APK SHA-256 hash lookup against 70+ antivirus engines
#   - Phishing & malicious URL domain reputation checks
#   - QR code URL scan and screenshot OCR link verification
# Free key available at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ONECLICK_VT_API_KEY=your_virustotal_api_key_here

# -----------------------------------------------------------------------------
# 2. Telegram Bot Token
# -----------------------------------------------------------------------------
# Required for:
#   - Running the OneClick Telegram Bot (telegram_bot.py)
# Create a bot and get a token via Telegram:
#   1. Open Telegram and search for @BotFather
#   2. Send /newbot and follow instructions to get your API token
ONECLICK_TELEGRAM_TOKEN=your_telegram_bot_token_here

# -----------------------------------------------------------------------------
# 3. HaveIBeenPwned (HIBP) API Key (Optional)
# -----------------------------------------------------------------------------
# Required for:
#   - Deep email data breach checks in Breach Checker
# Note: Password breach check uses free k-anonymity and does NOT require a key.
# Get a key at: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=your_haveibeenpwned_api_key_here

# -----------------------------------------------------------------------------
# 4. Server & Network Configuration (Optional)
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
API_BASE_URL=http://localhost:8000

